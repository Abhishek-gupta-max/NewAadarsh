# Copy to .env.local (development) or set in the hosting panel (production).
# Use the EXISTING database credentials — do not point this at a new/empty database.

PORT=3000

# Existing MySQL database. Never prefix these with NEXT_PUBLIC_ — they must stay server-side.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Browser origins allowed to call the API from another domain (comma-separated).
# Not needed when the website is served by this same app. localhost:5173 is allowed automatically in development.
CORS_ORIGINS=https://newadarshmanpower.com,https://www.newadarshmanpower.com

# Absolute path of the existing "uploads" folder (contains resumes/).
# Defaults to ../uploads relative to this backend folder.
UPLOADS_DIR=
