# React frontend settings (copy to .env.local / .env.production). Only VITE_* values reach the browser —
# never put database or SMTP credentials here.

# Address of the Next.js backend.
# Leave EMPTY when the backend serves the website on the same domain (Hostinger single Node.js app,
# or local dev where Vite proxies /api to http://localhost:3000).
# Set it only when the backend runs on a different domain, e.g. https://api.newadarshmanpower.com
VITE_API_BASE_URL=
