# syntax=docker/dockerfile:1
# docker/Dockerfile.frontend.dev — Development-only frontend container
# Used by docker/docker-compose.yml. Not for production.

FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# Run Vite dev server with host binding so Docker port mapping works
CMD ["npx", "vite", "--host", "0.0.0.0"]
