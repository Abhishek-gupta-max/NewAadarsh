# syntax=docker/dockerfile:1
# docker/Dockerfile.backend.dev — Development-only backend container
# Used by docker/docker-compose.yml. Not for production.

FROM node:22-alpine

WORKDIR /app

# Install dependencies first (layer-cached)
COPY package*.json ./
RUN npm ci

# Copy source (volume mount in dev will override this)
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
